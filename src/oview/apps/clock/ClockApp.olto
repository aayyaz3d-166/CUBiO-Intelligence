// Clock — Sovereign World Clock, Stopwatch & Countdown Timer
// ==============================================================================
// Pure Canonical OLTO Frontend Component.
// Zero external dependencies — 100% Sovereign ONE Language substrate.
// ==============================================================================

component ClockApp {
    state currentTab: String = "world"
    state activeCity: String = "Karachi"
    state stopwatchTimeMs: Number = 0
    state isStopwatchActive: Boolean = false
    state timerSecondsRemaining: Number = 300
    state isTimerRunning: Boolean = false

    action switchTab(tabName: String) {
        currentTab = tabName
    }

    action selectCity(cityName: String) {
        activeCity = cityName
    }

    action toggleStopwatch() {
        isStopwatchActive = !isStopwatchActive
    }

    action resetStopwatch() {
        isStopwatchActive = false
        stopwatchTimeMs = 0
    }

    action setTimerSeconds(secCount: Number) {
        timerSecondsRemaining = secCount
    }

    view {
        Container(maxWidth: 1200, padding: 16) {
            Card(padding: 16, radius: 12, elevation: 2) {
                Row(justify: "between", align: "center", marginBottom: 14) {
                    Text("Oview Clock — Time & Precision Substrate", size: 22, weight: "bold", color: "white")
                    Badge(label: "Millisecond Precision", color: "blue")
                }

                Row(gap: 8, marginBottom: 16) {
                    Button(label: "World Clock", variant: currentTab == "world" ? "solid" : "outline", onClick: { switchTab("world") })
                    Button(label: "Stopwatch", variant: currentTab == "stopwatch" ? "solid" : "outline", onClick: { switchTab("stopwatch") })
                    Button(label: "Countdown Timer", variant: currentTab == "timer" ? "solid" : "outline", onClick: { switchTab("timer") })
                }

                Card(padding: 24, radius: 10, background: "#050814") {
                    Text("Active Clock Zone: \(activeCity)", size: 18, weight: "bold", color: "green", marginBottom: 8)
                    Text("Timekeeping Matrix: Synchronized with Address369 Spatial Time Base", size: 12, color: "gray", marginBottom: 16)

                    Row(gap: 8) {
                        Button(label: "Karachi (PKT)", variant: activeCity == "Karachi" ? "solid" : "outline", onClick: { selectCity("Karachi") })
                        Button(label: "Tokyo (JST)", variant: activeCity == "Tokyo" ? "solid" : "outline", onClick: { selectCity("Tokyo") })
                        Button(label: "London (GMT)", variant: activeCity == "London" ? "solid" : "outline", onClick: { selectCity("London") })
                        Button(label: "New York (EST)", variant: activeCity == "New York" ? "solid" : "outline", onClick: { selectCity("New York") })
                    }
                }
            }
        }
    }
}
