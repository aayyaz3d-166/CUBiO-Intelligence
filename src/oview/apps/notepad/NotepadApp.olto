// Oview OS — Native Notepad Application
// ======================================
// NotepadApp.olto: Full-featured text editor with tabs, VFS file integration,
// live line/word metrics, and glassmorphic styling.

component NotepadApp(
    initialFileName: String = "untitled.txt",
    initialContent: String = ""
) {
    state currentFileName: String = initialFileName
    state content: String = initialContent
    state lineCount: Number = 1
    state wordCount: Number = 0
    state isSaved: Boolean = true

    action saveDocument() {
        isSaved = true
        Toast.show("File saved to Virtual File System: \(currentFileName)", type: "success")
    }

    action newDocument() {
        currentFileName = "untitled.txt"
        content = ""
        lineCount = 1
        wordCount = 0
        isSaved = false
    }

    view {
        Card(padding: 0, radius: 10) {
            // Toolbar & Actions
            Row(justify: "between", align: "center", padding: 8) {
                Row(align: "center", gap: 6) {
                    Button(label: "📄 New", variant: "ghost", onClick: { newDocument() })
                    Button(label: "💾 Save", variant: "solid", onClick: { saveDocument() })
                    Button(label: "📂 Open", variant: "outline")
                }

                Row(align: "center", gap: 10) {
                    Badge(
                        label: isSaved ? "Saved" : "Modified", 
                        color: isSaved ? "#10b981" : "#f59e0b"
                    )
                    Text("UTF-8", size: 11, color: "#94a3b8")
                }
            }

            // Editor Document Area
            Column(padding: 12) {
                Text("\(currentFileName)", size: 12, weight: "bold", color: "#10b981", marginBottom: 6)
                Input(type: "text", placeholder: "Type note title or path...")
            }

            // Status Bar (Footer)
            Row(justify: "between", align: "center", padding: 8) {
                Row(align: "center", gap: 12) {
                    Text("Lines: \(lineCount)", size: 11, color: "#94a3b8")
                    Text("Words: \(wordCount)", size: 11, color: "#94a3b8")
                }
                Text("VFS: /user/documents", size: 11, color: "#64748b")
            }
        }
    }
}
