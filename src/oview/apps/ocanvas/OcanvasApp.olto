// Oview OS — Sovereign Infinite Whiteboard Application (Phase 12: Ocanvas)
// =========================================================================
// OcanvasApp.olto: 2D infinite spatial canvas, interactive sticky notes,
// mind-mapping connector arrows, flowcharts, and board persistence.

component OcanvasApp(
    initialTitle: String = "System Architecture Mindmap"
) {
    state boardTitle: String = initialTitle
    state activeTool: String = "select"
    state zoomLevel: Number = 100
    state panX: Number = 0
    state panY: Number = 0
    state itemCount: Number = 4

    action setTool(tool: String) {
        activeTool = tool
        Toast.show("Active tool: \(activeTool)", type: "info")
    }

    action addSticky(color: String) {
        itemCount = itemCount + 1
        Toast.show("Added sticky note", type: "success")
    }

    action resetZoom() {
        zoomLevel = 100
        panX = 0
        panY = 0
    }

    view {
        Card(padding: 0, radius: 10) {
            // Whiteboard Toolbar
            Row(justify: "between", align: "center", padding: 8) {
                Row(align: "center", gap: 8) {
                    Text("🎨 Ocanvas", size: 14, weight: "bold", color: "#38bdf8")
                    Button(label: "🖐️ Hand", variant: "ghost", onClick: { setTool("hand") })
                    Button(label: "📝 Sticky", variant: "solid", onClick: { addSticky("yellow") })
                    Button(label: "⬜ Shape", variant: "ghost", onClick: { setTool("shape") })
                    Button(label: "➔ Arrow", variant: "ghost", onClick: { setTool("arrow") })
                }
                Row(align: "center", gap: 6) {
                    Button(label: "Zoom: \(zoomLevel)%", variant: "outline", onClick: { resetZoom() })
                    Button(label: "💾 Save Board", variant: "solid")
                }
            }

            // Canvas Body
            Column(gap: 8, padding: 12) {
                Text("Infinite Mind-Mapping Surface", size: 12, color: "#94a3b8")
                Row(gap: 12) {
                    Card(padding: 10, radius: 8) {
                        Text("💡 Core Idea: Sovereign AI Desktop", size: 12)
                    }
                    Card(padding: 10, radius: 8) {
                        Text("➔ Connects to Qplayer VM", size: 12)
                    }
                }
            }
        }
    }
}
