// CUBiO Sovereign Browser Component
// ==============================================================================
// Pure Canonical OLTO Frontend Component powered by FreeTree Engine.
// Zero external dependencies — 100% Sovereign ONE Language substrate.
// ==============================================================================

component CubioApp {
    state currentUrl: String = "cubio://home"
    state activeTab: String = "Sovereign Portal"
    state isDevToolsOpen: Boolean = false

    action navigate(url: String) {
        currentUrl = url
    }

    action toggleDevTools() {
        isDevToolsOpen = !isDevToolsOpen
    }

    view {
        Container(maxWidth: 1200, padding: 16) {
            Card(padding: 16, radius: 12, elevation: 2) {
                Row(justify: "between", align: "center", marginBottom: 12) {
                    Row(gap: 8, align: "center") {
                        Button(label: "Home", variant: "outline", onClick: { navigate("cubio://home") })
                        Button(label: "Docs", variant: "outline", onClick: { navigate("cubio://docs") })
                        Button(label: "Playground", variant: "outline", onClick: { navigate("cubio://playground") })
                    }
                    Badge(label: "FreeTree Engine: Active", color: "green")
                }

                Row(gap: 8, align: "center", marginBottom: 16) {
                    Input(value: currentUrl, placeholder: "cubio://...", width: "80%")
                    Button(label: "Go", variant: "solid", onClick: { navigate(currentUrl) })
                    Button(label: "DevTools", variant: "ghost", onClick: { toggleDevTools() })
                }

                Card(padding: 24, radius: 10, background: "#090d16") {
                    Text("CUBiO Sovereign Browser", size: 24, weight: "bold", color: "white")
                    Text("Powered by the FreeTree Engine (Zero-Bloat V8 Equivalent).", size: 14, color: "green", marginTop: 4)
                    Text("Current URL: \(currentUrl)", size: 13, color: "gray", marginTop: 8)
                    Spacer(16)
                    Row(gap: 12) {
                        Button(label: "Open Docs", variant: "outline", onClick: { navigate("cubio://docs") })
                        Button(label: "Open Playground", variant: "outline", onClick: { navigate("cubio://playground") })
                    }
                }
            }
        }
    }
}
