// Oview OS — Native Settings & System Control Application
// =======================================================
// SettingsApp.olto: Personalization, theme selection, display settings,
// and Address369 spatial memory diagnostics.

component SettingsApp(
    currentTheme: String = "cyber-glass"
) {
    state theme: String = currentTheme
    state accentColor: String = "#10b981"
    state autoSaveEnabled: Boolean = true

    action setTheme(newTheme: String) {
        theme = newTheme
        Toast.show("System theme changed to: \(theme)", type: "success")
    }

    view {
        Card(padding: 16, radius: 12) {
            // Header
            Row(justify: "between", align: "center", marginBottom: 16) {
                Text("System Settings", size: 18, weight: "bold", color: "#10b981")
                Badge(label: "Oview OS v1.0.0", color: "#10b981")
            }

            // Theme Selection Section
            Text("THEMES & PERSONALIZATION", size: 11, weight: "bold", color: "#94a3b8", marginBottom: 8)
            Grid(columns: 3, gap: 10, marginBottom: 16) {
                Card(padding: 10, radius: 8) {
                    Text("Cyber Glass", size: 12, weight: "bold", color: "#10b981")
                    Text("Emerald Glow", size: 10, color: "#94a3b8")
                    Spacer(6)
                    Button(label: "Apply", variant: "solid", onClick: { setTheme("cyber-glass") })
                }

                Card(padding: 10, radius: 8) {
                    Text("Deep Space", size: 12, weight: "bold", color: "#60a5fa")
                    Text("Electric Blue", size: 10, color: "#94a3b8")
                    Spacer(6)
                    Button(label: "Apply", variant: "outline", onClick: { setTheme("deep-space") })
                }

                Card(padding: 10, radius: 8) {
                    Text("Neon Matrix", size: 12, weight: "bold", color: "#f43f5e")
                    Text("Cyberpunk Red", size: 10, color: "#94a3b8")
                    Spacer(6)
                    Button(label: "Apply", variant: "outline", onClick: { setTheme("neon-matrix") })
                }
            }

            // Invariant & Memory Inspector Section
            Text("ARCHITECTURE & INVARIANTS", size: 11, weight: "bold", color: "#94a3b8", marginBottom: 8)
            Card(padding: 12, radius: 8) {
                Column(gap: 4) {
                    Text("• Address369 Bounded Spatial Slots: Enforced", size: 12, color: "#cbd5e1")
                    Text("• Qplayer Register VM ops/sec: 204.8M", size: 12, color: "#cbd5e1")
                    Text("• ECHO-1 Offline Brain Footprint: 24.56 MB", size: 12, color: "#10b981")
                    Text("• Zero Secret Leakage (E9001): Verified", size: 12, color: "#cbd5e1")
                }
            }
        }
    }
}
