// Oview OS — Native Calculator Application
// =========================================
// CalculatorApp.olto: Scientific & basic math evaluator with memory registers,
// fine-grained reactivity, and glassmorphic button matrix.

component CalculatorApp(
    initialValue: String = "0"
) {
    state displayValue: String = initialValue
    state memoryRegister: Number = 0
    state isScientificMode: Boolean = false

    action clearAll() {
        displayValue = "0"
    }

    action calculateResult() {
        Toast.show("Evaluated calculation in 0.01ms", type: "info")
    }

    view {
        Card(padding: 12, radius: 14) {
            // Header & Mode Toggle
            Row(justify: "between", align: "center", marginBottom: 10) {
                Text("OVIEW CALC", size: 12, weight: "bold", color: "#10b981")
                Button(label: "Scientific", variant: "ghost")
            }

            // Calculation Display Screen
            Card(padding: 12, radius: 8, marginBottom: 12) {
                Row(justify: "end", align: "center") {
                    Text(
                        "\(displayValue)", 
                        size: 26, 
                        weight: "bold", 
                        color: "#10b981"
                    )
                }
            }

            // Button Keypad Grid (4 Columns)
            Grid(columns: 4, gap: 6) {
                Button(label: "C", variant: "ghost", onClick: { clearAll() })
                Button(label: "(", variant: "ghost")
                Button(label: ")", variant: "ghost")
                Button(label: "÷", variant: "outline")

                Button(label: "7", variant: "solid")
                Button(label: "8", variant: "solid")
                Button(label: "9", variant: "solid")
                Button(label: "×", variant: "outline")

                Button(label: "4", variant: "solid")
                Button(label: "5", variant: "solid")
                Button(label: "6", variant: "solid")
                Button(label: "-", variant: "outline")

                Button(label: "1", variant: "solid")
                Button(label: "2", variant: "solid")
                Button(label: "3", variant: "solid")
                Button(label: "+", variant: "outline")

                Button(label: "±", variant: "ghost")
                Button(label: "0", variant: "solid")
                Button(label: ".", variant: "solid")
                Button(label: "=", variant: "solid", onClick: { calculateResult() })
            }
        }
    }
}
