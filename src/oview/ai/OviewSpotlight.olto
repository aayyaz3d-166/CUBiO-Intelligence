// Oview OS — Sovereign Spotlight & ECHO-1 Search Overlay
// =======================================================
// OviewSpotlight.olto: Global modal search dialog (Ctrl + Space) for instant
// application launching, VFS file discovery, and offline AI execution.

component OviewSpotlight(
    placeholderText: String = "Search apps, files, or ask ECHO-1..."
) {
    state query: String = ""
    state activeCategory: String = "all"
    state isOfflineBrainReady: Boolean = true

    action executeSearch(q: String) {
        Toast.show("Spotlight searching for: \(q)", type: "info")
    }

    view {
        Card(padding: 16, radius: 18) {
            // Search Input Header
            Row(align: "center", gap: 12, marginBottom: 14) {
                Text("🤖", size: 24)
                Input(
                    placeholder: "\(placeholderText)"
                )
                Badge(label: "ECHO-1 READY", color: "#10b981")
            }

            // Category Filter Pills
            Row(align: "center", gap: 8, marginBottom: 12) {
                Badge(label: "All Results", color: "#10b981")
                Badge(label: "Applications", color: "#3b82f6")
                Badge(label: "VFS Files", color: "#8b5cf6")
                Badge(label: "AI Reasoning", color: "#f59e0b")
            }

            // Results List
            Column(gap: 6) {
                Card(padding: 10, radius: 8) {
                    Row(align: "center", gap: 10) {
                        Text("📝", size: 18)
                        Text("Oview Notepad — Open text editor", size: 12, weight: "bold")
                    }
                }

                Card(padding: 10, radius: 8) {
                    Row(align: "center", gap: 10) {
                        Text("📄", size: 18)
                        Text("welcome.txt — /user/documents", size: 12, color: "#10b981")
                    }
                }
            }

            Spacer(12)

            // Shortcut Hint Footer
            Row(justify: "between", align: "center") {
                Text("Press [Enter] to execute • [Esc] to dismiss", size: 11, color: "#94a3b8")
                Text("4ms Local Neural Latency", size: 11, color: "#10b981")
            }
        }
    }
}
