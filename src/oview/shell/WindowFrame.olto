// Oview OS — Sovereign Desktop Window Frame Chassis
// ==================================================
// WindowFrame.olto: Reusable glassmorphic window frame component with
// draggable title bar, controls (minimize, maximize, close), and active focus glow.

component WindowFrame(
    title: String = "Application Window",
    icon: String = "🪟",
    isFocused: Boolean = true,
    isMaximized: Boolean = false
) {
    state borderColor: String = isFocused ? "#10b981" : "rgba(255, 255, 255, 0.12)"
    state glowShadow: String = isFocused ? "0 8px 32px rgba(16, 185, 129, 0.25)" : "0 4px 20px rgba(0, 0, 0, 0.5)"

    view {
        Card(padding: 0, radius: 14) {
            // Window Title Bar (Draggable Drag Handle)
            Row(justify: "between", align: "center", padding: 12) {
                // Window Title & App Icon
                Row(align: "center", gap: 10) {
                    Text("\(icon)", size: 16)
                    Text(
                        "\(title)", 
                        size: 13, 
                        weight: "bold", 
                        color: isFocused ? "#f8fafc" : "#94a3b8"
                    )
                }

                // Window Control Buttons (Min, Max, Close)
                Row(align: "center", gap: 6) {
                    Button(
                        label: "─", 
                        variant: "ghost"
                    )

                    Button(
                        label: isMaximized ? "❐" : "□", 
                        variant: "ghost"
                    )

                    Button(
                        label: "✕", 
                        variant: "ghost"
                    )
                }
            }
        }
    }
}
