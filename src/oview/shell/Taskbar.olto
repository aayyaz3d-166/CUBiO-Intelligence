// Oview OS — Sovereign Taskbar & System Dock
// ============================================
// Taskbar.olto: Bottom desktop panel with sovereign Start Menu launcher,
// running application tabs, system telemetry indicators, and live digital clock.

component Taskbar(
    activeTasksCount: Number = 0,
    currentTime: String = "12:00:00",
    cpuUsage: String = "1.2%"
) {
    state isMenuOpen: Boolean = false
    state activeTheme: String = "cyber-glass"

    view {
        Card(padding: 6, radius: 12) {
            Row(justify: "between", align: "center", gap: 8) {
                // Left: Sovereign Start Launcher
                Row(align: "center", gap: 10) {
                    Button(
                        label: "◈ OVIEW", 
                        variant: "solid",
                        onClick: { isMenuOpen = !isMenuOpen }
                    )

                    Badge(
                        label: "Tasks: \(activeTasksCount)", 
                        color: "#10b981"
                    )
                }

                // Center: Quick App Launchers
                Row(align: "center", gap: 6) {
                    Button(label: "📝 Notes", variant: "ghost")
                    Button(label: "📁 Files", variant: "ghost")
                    Button(label: "⚡ Term", variant: "ghost")
                    Button(label: "🧮 Calc", variant: "ghost")
                    Button(label: "🤖 ECHO", variant: "ghost")
                }

                // Right: System Status & Clock Tray
                Row(align: "center", gap: 12) {
                    Badge(
                        label: "CPU: \(cpuUsage)", 
                        color: "#3b82f6"
                    )

                    Badge(
                        label: "RAM: 24.5MB", 
                        color: "#8b5cf6"
                    )

                    Text(
                        "\(currentTime)", 
                        size: 13, 
                        weight: "bold", 
                        color: "#f8fafc"
                    )
                }
            }
        }
    }
}
