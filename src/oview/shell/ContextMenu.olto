// Context Menu — Sovereign Desktop Shell
// ==============================================================================
// Pure Canonical OLTO Frontend Component.
// Zero external dependencies — 100% Sovereign ONE Language substrate.
// ==============================================================================

component ContextMenu {
    state posX: Number = 0
    state posY: Number = 0
    state isMenuVisible: Boolean = false

    action showMenu(xVal: Number, yVal: Number) {
        posX = xVal
        posY = yVal
        isMenuVisible = true
    }

    action hideMenu() {
        isMenuVisible = false
    }

    view {
        Container(maxWidth: 240, padding: 4) {
            Card(padding: 8, radius: 10, elevation: 4) {
                Button(label: "Refresh Desktop", variant: "ghost", onClick: { hideMenu() })
                Button(label: "New Text Note", variant: "ghost", onClick: { hideMenu() })
                Button(label: "New VFS Folder", variant: "ghost", onClick: { hideMenu() })
                Button(label: "Change Wallpaper", variant: "ghost", onClick: { hideMenu() })
                Button(label: "System Settings", variant: "ghost", onClick: { hideMenu() })
            }
        }
    }
}
