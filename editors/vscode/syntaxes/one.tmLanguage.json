{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ONE Language",
  "scopeName": "source.one",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#spatial-directives" },
    { "include": "#declarations" },
    { "include": "#control-flow" },
    { "include": "#modules" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#builtin-functions" },
    { "include": "#stdlib-functions" },
    { "include": "#function-definitions" },
    { "include": "#type-definitions" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.one",
          "match": "//.*$"
        },
        {
          "name": "comment.block.one",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.one",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.one",
              "match": "\\\\([nrtbfv\\\\'\"]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        },
        {
          "name": "string.quoted.single.one",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.one",
              "match": "\\\\([nrtbfv\\\\'\"]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.one",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.hex.one",
          "match": "\\b0x[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.integer.one",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.one",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.one",
          "match": "\\bnull\\b"
        }
      ]
    },
    "spatial-directives": {
      "patterns": [
        {
          "name": "entity.name.tag.directive.spatial.one",
          "match": "(@Space|@Grid777|@Slice|@memview|@seal|@gossip|@assert_rss|@actuation_lock)\\b"
        },
        {
          "name": "keyword.control.spatial.one",
          "match": "\\b(node|stream|align|checkpoint|seal|funnel|channel|rss_max)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "storage.type.one",
          "match": "\\b(let|const|struct|enum|class|constructor|method|function|fn|native|private|public)\\b"
        }
      ]
    },
    "control-flow": {
      "patterns": [
        {
          "name": "keyword.control.flow.one",
          "match": "\\b(if|else|while|for|return|async|await)\\b"
        }
      ]
    },
    "modules": {
      "patterns": [
        {
          "name": "keyword.control.module.one",
          "match": "\\b(module|import|export|from|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.one",
          "match": "\\b(Int|Int32|Float32|Bool|Void|string|number|boolean|any)\\b"
        }
      ]
    },
    "builtin-functions": {
      "patterns": [
        {
          "name": "support.function.builtin.one",
          "match": "\\b(print|Cast|Sqrt|Clamp)\\b"
        }
      ]
    },
    "stdlib-functions": {
      "patterns": [
        {
          "name": "support.function.stdlib.one",
          "match": "\\b(len|keys|values|push|pop|abs|floor|ceil|round|pow|min|max|now|format|parse|readFile|writeFile|exists)\\b"
        }
      ]
    },
    "function-definitions": {
      "patterns": [
        {
          "match": "\\b(?:function|fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.one" }
          }
        }
      ]
    },
    "type-definitions": {
      "patterns": [
        {
          "match": "\\b(?:struct|enum|class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.class.one" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.one" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.flow.one",
          "match": "(->|=>)"
        },
        {
          "name": "keyword.operator.comparison.one",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.one",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.range.one",
          "match": "(\\.\\.|\\|)"
        },
        {
          "name": "keyword.operator.arithmetic.one",
          "match": "(\\+|\\-|\\*|\\/|\\%)"
        },
        {
          "name": "keyword.operator.assignment.one",
          "match": "(=)"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.one",
          "match": "(;|:|,|\\.)"
        },
        {
          "name": "punctuation.section.brackets.one",
          "match": "(\\{|\\}|\\[|\\]|\\(|\\))"
        }
      ]
    }
  }
}
