{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "OLTO",
  "scopeName": "source.olto",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#component-tags" },
    { "include": "#lifecycle" },
    { "include": "#types" },
    { "include": "#attributes" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.olto",
          "match": "//.*$"
        },
        {
          "name": "comment.block.olto",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.olto",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.olto",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.olto",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.olto",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.olto",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.olto",
          "match": "\\b(if|else|return|for|in|while)\\b"
        },
        {
          "name": "keyword.declaration.olto",
          "match": "\\b(component|page|state|computed|action|let|const)\\b"
        },
        {
          "name": "keyword.control.import-export.olto",
          "match": "\\b(import|export|from|as)\\b"
        },
        {
          "name": "constant.language.boolean.olto",
          "match": "\\b(true|false|null|undefined)\\b"
        }
      ]
    },
    "lifecycle": {
      "patterns": [
        {
          "name": "support.function.lifecycle.olto",
          "match": "\\b(onMount|onDestroy)\\b"
        }
      ]
    },
    "component-tags": {
      "patterns": [
        {
          "name": "entity.name.tag.olto",
          "match": "</?[A-Z][a-zA-Z0-9_]*"
        },
        {
          "name": "support.class.component.olto",
          "match": "\\b(Container|Row|Column|Grid|Text|Button|Input|Card|Modal|Image|Badge|LoadingSpinner|Spacer|Toast)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.olto",
          "match": "\\b(string|number|boolean|any|void|Array|List|Map)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.olto",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:|=)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.olto",
          "match": "(=|\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.comparison.olto",
          "match": "(===|==|!==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.olto",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.olto",
          "match": "(\\+|\\-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.arrow.olto",
          "match": "=>"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.separator.olto",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.bracket.olto",
          "match": "[\\{\\}\\[\\]\\(\\)]"
        }
      ]
    }
  }
}
