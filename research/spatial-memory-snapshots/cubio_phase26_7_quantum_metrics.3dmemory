  "framework1_SymplecticRank": {
    "reference": "Chabaud, U. & Mele, A.A. (2024) — Symplectic rank of Gaussian states",
    "formula": "s_symp = #{j : dⱼ > 1}",
    "physicalMeaning": "dⱼ = Williamson symplectic eigenvalue of covariance matrix Γ",
    "uncertaintyPrinciple": "dⱼ ≥ 1 ALWAYS (Robertson-Schrödinger bound)",
    "thermalMapping": "dⱼ = 2·n̄ⱼ + 1 (photon number to eigenvalue)",
    "singleModeWilliamson": "d = sqrt(det(V)) = sqrt(Vxx·Vpp - Vxp²)",
    "complexityClasses": {
      "CLASSICALLY_SIMULABLE": "s_symp = 0 (pure Gaussian state)",
      "BOUNDARY": "s_symp ≤ floor(log₂ n) (polylog-sparse mixed)",
      "QUANTUM_HARD": "s_symp > floor(log₂ n) (dense mixed state)"
    }
  },
  "framework2_isoTNS": {
