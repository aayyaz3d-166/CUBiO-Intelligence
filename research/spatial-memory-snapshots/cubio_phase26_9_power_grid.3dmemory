  "testSuite": "scratch/cubio_neural_lattice/tests/test_phase26_9_power_grid.ts",
  "equations": {
    "1_SwingEquation": {
      "author": "Hantao Cui (IEEE Trans. Power Syst. 2023)",
      "formula": "2H_eq · dω/dt = P_m - P_e - D·Δω",
      "integration": "ω[k+1] = ω[k] + dω/dt · Δt, δ[k+1] = δ[k] + ω[k] · Δt",
      "stability": "|Δω| < 0.5 Hz · 2π"
    },
    "2_IncCondMPPT": {
      "author": "Sangeetha Manickam (IEEE TPEL 2022)",
      "condition": "dI/dV = -I/V at Maximum Power Point (MPP)",
      "errorMetric": "ε = dI/dV + I/V",
      "action": "ε > 0 → INCREASE_V, ε < 0 → DECREASE_V, ε ≈ 0 → AT_MPP"
    },
    "3_DABPower": {
      "author": "Dongsheng Yu (IEEE JESTPE 2021)",
      "formula": "P_DAB = (n·V1·V2)/(ω·L) · φ·(1 - |φ|/π)",
      "pMax": "P_max = n·V1·V2·π / (4·ω·L) at |φ| = π/2",
      "optimalPhiSolver": "Quadratic root for exact closed-form power targeting"
    },
    "4_RippleMinimization": {
      "author": "Guidong Zhang (IEEE TPEL 2022)",
      "formula": "φ_k = 2π(k-1)/N for k=1..N",
      "rippleReduction": "ΔVo_optimal = ΔVo_single / N"
    }
  },
