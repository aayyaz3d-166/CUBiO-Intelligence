// =====================================================================
// ONE LANGUAGE NATIVE KEEP NOTES APPLICATION
// Theme: Glassmorphism Aesthetic with Emerald Green & Sunset Orange Accents
// Zero External Dependencies — 100% Pure Sovereign ONE Language
// =====================================================================

// ANSI Color & Styling Escape Sequences
const C_RESET: string = "\x1b[0m";
const C_BOLD: string = "\x1b[1m";
const C_DIM: string = "\x1b[2m";

// Green Palette (Emerald & Mint)
const C_GREEN_BG: string = "\x1b[48;2;16;185;129m";
const C_GREEN_FG: string = "\x1b[38;2;52;211;153m";
const C_GREEN_DEEP: string = "\x1b[38;2;16;185;129m";

// Orange Palette (Sunset & Tangerine)
const C_ORANGE_BG: string = "\x1b[48;2;249;115;22m";
const C_ORANGE_FG: string = "\x1b[38;2;251;146;60m";
const C_ORANGE_DEEP: string = "\x1b[38;2;234;88;12m";

// Frosted Glass Palette (Translucent Dark Slate)
const C_GLASS_PANEL: string = "\x1b[48;2;18;24;38m";
const C_GLASS_CARD: string = "\x1b[48;2;26;34;52m";
const C_GLASS_BORDER: string = "\x1b[38;2;75;85;105m";
const C_WHITE: string = "\x1b[38;2;248;250;252m";
const C_MUTED: string = "\x1b[38;2;148;163;184m";

function renderHeader(): void {
    print "";
    print C_GLASS_PANEL + C_GREEN_FG + " ╔══════════════════════════════════════════════════════════════════════╗ " + C_RESET;
    print C_GLASS_PANEL + C_GREEN_FG + " ║  " + C_BOLD + C_WHITE + "✦ ONE NOTES " + C_RESET + C_GLASS_PANEL + C_ORANGE_FG + "— Glassmorphic Personal Notebook for PC" + C_RESET + C_GLASS_PANEL + C_GREEN_FG + "             ║ " + C_RESET;
    print C_GLASS_PANEL + C_GREEN_FG + " ║  " + C_DIM + C_MUTED + "Theme: Frosted Glass " + C_RESET + C_GLASS_PANEL + C_GREEN_DEEP + "[Emerald Green]" + C_RESET + C_GLASS_PANEL + C_MUTED + " & " + C_ORANGE_DEEP + "[Sunset Orange]" + C_RESET + C_GLASS_PANEL + C_GREEN_FG + "       ║ " + C_RESET;
    print C_GLASS_PANEL + C_GREEN_FG + " ╚══════════════════════════════════════════════════════════════════════╝ " + C_RESET;
    print "";
}

function renderNoteCard(id: number, title: string, content: string, tag: string, isPinned: boolean): void {
    let accentFg: string = C_GREEN_FG;
    let badgeBg: string = C_GREEN_BG;
    let pinSymbol: string = " ";
    
    if (isPinned) {
        accentFg = C_ORANGE_FG;
        badgeBg = C_ORANGE_BG;
        pinSymbol = "📌 PINNED ";
    }

    print C_GLASS_CARD + accentFg + " ╭── [Note #" + id + "] " + pinSymbol + "──────────────────────────────────────" + C_RESET;
    print C_GLASS_CARD + C_WHITE + C_BOLD + " │ ❖ Title:   " + title + C_RESET;
    print C_GLASS_CARD + C_MUTED + " │ ❖ Category: " + badgeBg + C_WHITE + " " + tag + " " + C_RESET + C_GLASS_CARD + C_RESET;
    print C_GLASS_CARD + C_WHITE + " │ ❖ Content:  " + content + C_RESET;
    print C_GLASS_CARD + accentFg + " ╰───────────────────────────────────────────────────────────── " + C_RESET;
    print "";
}

function main(): void {
    renderHeader();

    // In-memory sovereign note items without any 3rd party package
    let titles: string[] = [
        "ONE Language Compiler Architecture",
        "Keep Notes Glassmorphism Concept",
        "PC System Performance Benchmark",
        "Offline Neural Model (ECHO-1)"
    ];

    let contents: string[] = [
        "Deterministic single-pass parser with zero-dependency execution.",
        "Emerald green and sunset orange frosted glass cards with smooth borders.",
        "UnifiedVM achieving bit-exact reproducibility and high throughput.",
        "Built-in offline neural intelligence with instant response."
    ];

    let tags: string[] = [
        "DEV",
        "DESIGN",
        "SYSTEM",
        "AI"
    ];

    let pinned: boolean[] = [
        true,
        true,
        false,
        false
    ];

    let totalNotes: number = 4;

    print C_BOLD + C_GREEN_FG + " 📋 Active Notes Catalog (" + totalNotes + " Notes Loaded):" + C_RESET;
    print C_DIM + C_MUTED + " ---------------------------------------------------------------" + C_RESET;
    print "";

    let i: number = 0;
    while (i < totalNotes) {
        let noteId: number = i + 1;
        let t: string = titles[i];
        let c: string = contents[i];
        let tg: string = tags[i];
        let p: boolean = pinned[i];

        renderNoteCard(noteId, t, c, tg, p);
        i = i + 1;
    }

    // Interactive Action Summary Panel
    print C_GLASS_PANEL + C_ORANGE_FG + " ┌─── ⚡ Quick Actions (Zero-Dependency Sovereign Engine) ──────┐" + C_RESET;
    print C_GLASS_PANEL + C_WHITE + " │ " + C_GREEN_FG + "[1] View All Notes" + C_WHITE + "       │ " + C_ORANGE_FG + "[2] Pin / Unpin Note" + C_WHITE + "              │" + C_RESET;
    print C_GLASS_PANEL + C_WHITE + " │ " + C_GREEN_FG + "[3] Filter by Tag" + C_WHITE + "        │ " + C_ORANGE_FG + "[4] Export to Markdown File" + C_WHITE + "        │" + C_RESET;
    print C_GLASS_PANEL + C_ORANGE_FG + " └──────────────────────────────────────────────────────────────┘" + C_RESET;
    print "";

    // Simulated Auto-Export via built-in sovereign StdIO
    let exportFileName: string = "keep_notes_backup.md";
    let exportData: string = "# ONE Notes Backup\n\n- Note 1: ONE Language Compiler Architecture (PINNED)\n- Note 2: Keep Notes Glassmorphism Concept (PINNED)\n- Note 3: PC System Performance Benchmark\n- Note 4: Offline Neural Model (ECHO-1)\n";
    io_write(exportFileName, exportData);

    print C_GREEN_FG + " ✔ System Status: " + C_WHITE + "All notes safely loaded in sovereign memory." + C_RESET;
    print C_ORANGE_FG + " 💾 Backup Export: " + C_WHITE + "Auto-exported to '" + exportFileName + "' via native io_write." + C_RESET;
    print "";
}

main();
